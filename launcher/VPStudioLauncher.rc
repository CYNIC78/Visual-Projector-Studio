#include <windows.h>

// Главная иконка приложения (обязан быть самый маленький ID)
101 ICON "icon.ico"
IDI_APPICON ICON "icon.ico"
1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "VP Studio"
   VALUE "FileDescription", "VP Studio Launcher"
   VALUE "FileVersion", "0.1.0"
   VALUE "InternalName", "VPStudioLauncher"
   VALUE "OriginalFilename", "VP Studio.exe"
   VALUE "ProductName", "VP Studio"
   VALUE "ProductVersion", "0.1.0"
  END
 END
 BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END
END
